[Unit]
Description=OrderHub OMS
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/orderhub/state
EnvironmentFile=%h/orderhub/config/orderhub.env
ExecStart=%h/orderhub/current/bin/orderhub-node
KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=60
Restart=no
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orderhub

[Install]
WantedBy=default.target
