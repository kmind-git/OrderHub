[Unit]
Description=OrderHub OMS
After=network.target

[Service]
Type=simple
WorkingDirectory=%h
EnvironmentFile=%h/config/orderhub.env
ExecStartPre=/usr/bin/mkdir -p %h/data/checkpoints
ExecStart=%h/bin/orderhub-node
KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=60
Restart=no
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orderhub

[Install]
WantedBy=default.target
